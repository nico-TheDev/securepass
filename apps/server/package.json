{
  "name": "@securepass/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm --filter @securepass/web build && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm --filter @securepass/web build && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "predev": "pnpm --filter @securepass/web build",
    "pretest": "pnpm --filter @securepass/web build"
  },
  "dependencies": {
    "@securepass/crypto": "workspace:*",
    "@securepass/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "wrangler": "^4.110.0",
    "vitest": "^5.0.5",
    "@types/node": "^24.19.2"
  }
}
