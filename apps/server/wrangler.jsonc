{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "securepass",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "securepass",
      // Placeholder for local dev. The real id comes from `wrangler d1 create securepass` at first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The web vault build, served through the Worker so every file gets the security headers.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Daily: purge trash past 30 days, drop old tombstones, clear old login attempts and sessions.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
